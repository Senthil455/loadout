{
  "name": "expenses",
  "primary_key_column": "id",
  "enable_rls": false,
  "columns": [
    { "name": "show_id", "type": "UUID", "required": true,
      "foreign_key": { "references": "shows.id" } },
    { "name": "vendor", "type": "TEXT", "required": true, "max_length": 160 },
    { "name": "category", "type": "ENUM", "required": true, "default": "other",
      "options": ["production", "marketing", "hospitality", "venue", "other"] },
    { "name": "amount_cents", "type": "INTEGER", "required": true },
    { "name": "recoupable", "type": "BOOLEAN", "required": true, "default": true,
      "description": "True when the deal lets the venue take this expense out of the artist pool." },
    { "name": "receipt_ref", "type": "TEXT", "max_length": 160,
      "description": "Invoice or receipt id. Blank on a recoupable expense above the policy threshold blocks approval." },
    { "name": "incurred_on", "type": "DATE" },
    { "name": "note", "type": "TEXT", "max_length": 400 }
  ],
  "config": {}
}
